---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import Mark from '../components/Mark.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { config } from '../config';

interface Props {
  title: string;
  description?: string;
  // Share image. src may be absolute or site-relative.
  image?: { src: string; alt: string };
  type?: 'website' | 'article';
  publishedDate?: Date;
  updatedDate?: Date;
}

const defaultDescription =
  'A read-only directory of South African civic data sources and tools. Every entry shows its status, a confidence level and when it was last checked.';

const {
  title,
  description = defaultDescription,
  image,
  type = 'website',
  publishedDate,
  updatedDate,
} = Astro.props;

const fullTitle = `${title} | OpenForge`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = image ? new URL(image.src, Astro.site).href : null;

const path = Astro.url.pathname.replace(/\/?$/, '/');
const links = [
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
  { href: '/blog/', label: 'Blog' },
  { href: '/jobs/', label: 'Jobs' },
  { href: '/contact/', label: 'Contact' },
];
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

const entries = [...(await getCollection('resources')), ...(await getCollection('projects'))];
const dates = entries
  .map((e) => e.data.provenance.checkedOn)
  .filter((d): d is Date => d !== null);
const lastChecked = dates.length
  ? new Date(Math.max(...dates.map((d) => d.getTime()))).toISOString().slice(0, 10)
  : null;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="OpenForge" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && image && <meta property="og:image:alt" content={image.alt} />}
    {type === 'article' && publishedDate && (
      <meta property="article:published_time" content={publishedDate.toISOString()} />
    )}
    {type === 'article' && updatedDate && (
      <meta property="article:modified_time" content={updatedDate.toISOString()} />
    )}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap wrap-wide header-bar">
        <a class="brand" href="/" aria-label="OpenForge home">
          <Mark size={32} />
          <span class="wordmark"><span class="w-open">Open</span><span class="w-forge">Forge</span></span>
        </a>
        <button type="button" class="menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
          <svg class="i-open" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
            <rect x="2" y="5" width="20" height="2" fill="currentColor" />
            <rect x="2" y="11" width="20" height="2" fill="currentColor" />
            <rect x="2" y="17" width="20" height="2" fill="currentColor" />
          </svg>
          <svg class="i-close" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
            <path d="M5 5L19 19M19 5L5 19" stroke="currentColor" stroke-width="2.5" fill="none" />
          </svg>
        </button>
        <nav id="site-nav" class="site-nav" aria-label="Main">
          {links.map((l) => (
            <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap wrap-wide footer-shell">
        <div class="footer-columns">
          <div class="footer-brand">
            <div class="brand">
              <Mark size={32} />
              <span class="wordmark"><span class="w-open">Open</span><span class="w-forge">Forge</span></span>
            </div>
          </div>
          <section aria-labelledby="footer-about-title">
            <h2 id="footer-about-title">About us</h2>
            <p>OpenForge points to other people's work. It does not host their data and is not an official source.</p>
          </section>
          <nav class="footer-nav" aria-labelledby="footer-links-title">
            <h2 id="footer-links-title">Useful links</h2>
            {links.map((l) => <a href={l.href}>{l.label}</a>)}
            <a href="/privacy/">Privacy</a>
          </nav>
          <section class="footer-contact" aria-labelledby="footer-contact-title">
            <h2 id="footer-contact-title">Contact</h2>
            {config.contactEmail && <a href={`mailto:${config.contactEmail}`}>{config.contactEmail}</a>}
            {config.contactPhone && <a href={`tel:${config.contactPhone.replace(/[^\d+]/g, '')}`}>{config.contactPhone}</a>}
            <a class="footer-mailing" href="/about/#newsletter">Join our mailing list</a>
          </section>
        </div>
        <div class="footer-bottom">
          {config.repoUrl && <a href={config.repoUrl}>Source code</a>}
          <SocialLinks />
        </div>
        {lastChecked && <div class="footer-meta">Entries last checked {lastChecked}</div>}
      </div>
    </footer>
  </body>
</html>
<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('site-nav');
  if (btn && nav) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      nav.toggleAttribute('data-open', open);
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
  }
</script>
