---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import heroArt from '../assets/illustrations/home-hero.png';
import surfaceArt from '../assets/illustrations/surface.png';
import linkArt from '../assets/illustrations/link.png';
import buildArt from '../assets/illustrations/build.png';
import { getCollection } from 'astro:content';
import { getTools } from '../utils/tools';
const resources = await getCollection('resources');
const projects = await getCollection('projects');
const tools = await getTools();
const all = [...resources, ...projects];
const checkedCount = all.filter((e) => e.data.provenance.checkedOn !== null).length;
const rows = [
  { n: '01', title: 'Resources', text: 'Gazettes, tenders, municipal finance and legal sources, each with a status.' },
  { n: '02', title: 'Projects', text: 'The civic tools built on top of that data, and who maintains them.' },
  { n: '03', title: 'Provenance', text: 'Moved, dead and unverified entries are shown as such, not hidden.' },
];
const pillars = [
  { n: '01', title: 'Surface', text: 'Find civic data sources that are scattered and hard to reach.', image: surfaceArt },
  { n: '02', title: 'Link', text: 'Connect useful sources with the projects and people who use them.', image: linkArt },
  { n: '03', title: 'Build', text: 'Explore civic information through practical tools such as ForgeMap.', image: buildArt },
  { n: '04', title: 'Teach', text: 'Learn what the data says, where it came from, and how far to trust it.', image: null },
];
---
<Base title="Moving everything within reach | OpenForge">
  <section class="hero">
    <Image class="hero-art" src={heroArt} alt="A person uses a phone map to find civic services and public records." width={799} format="webp" loading="eager" />
    <h1>Moving everything within reach.</h1>
    <p>
      South Africa’s civic data is out there, but it’s buried and confusing. OpenForge surfaces
      the sources, links the tools, and teaches you how to use them — so you know what exists and
      how far to trust it.
    </p>
    <div class="actions">
      <a class="button" href="/resources/">
        Browse resources
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false"><path d="M3 10H17M11 4L17 10L11 16" stroke="currentColor" stroke-width="2" fill="none" /></svg>
      </a>
      <a class="button alt" href="/projects/">Browse projects</a>
    </div>
    {tools.length > 0 && (
      <section class="tools-section" aria-labelledby="tools-heading">
        <h2 id="tools-heading">Tools we’ve built</h2>
        <ul class="tool-cards">
          {tools.map((tool) => (
            <li class="tool-card">
              <h3>{tool.data.title}</h3>
              <p>{tool.data.summary}</p>
              {tool.data.url ? (
                <a class="card-link" href={tool.data.url} target="_blank" rel="noopener noreferrer">
                  Open tool <span aria-hidden="true">↗</span>
                </a>
              ) : (
                <span class="tool-status">Coming soon</span>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}
  </section>

  <section class="approach-section" aria-labelledby="approach-heading">
    <h2 id="approach-heading">What OpenForge does</h2>
    <ul class="approach-cards">
      {pillars.map((pillar) => (
        <li class="approach-card">
          <div class="approach-visual">
            {pillar.image ? (
              <Image src={pillar.image} alt="" width={360} format="webp" loading="lazy" />
            ) : (
              <span class="approach-number" aria-hidden="true">{pillar.n}</span>
            )}
          </div>
          <div class="approach-copy">
            <span class="approach-kicker">{pillar.n}</span>
            <h3>{pillar.title}</h3>
            <p>{pillar.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="panel">
    <div class="panel-inner">
      <h2>Know what you are looking at.</h2>
      <ul class="rows">
        {rows.map((r) => (
          <li>
            <div class="num">{r.n}</div>
            <h3>{r.title}</h3>
            <p>{r.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="tiles" aria-label="Directory totals">
    <div class="tile">
      <div class="big">{resources.length}</div>
      <div class="cap">{resources.length === 1 ? 'resource' : 'resources'}</div>
    </div>
    <div class="tile">
      <div class="big">{projects.length}</div>
      <div class="cap">{projects.length === 1 ? 'project' : 'projects'}</div>
    </div>
    <div class="tile accent">
      <div class="big">{checkedCount}/{all.length}</div>
      <div class="cap">checked</div>
    </div>
  </section>
</Base>