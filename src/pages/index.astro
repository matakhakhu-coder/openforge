---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const resources = await getCollection('resources');
const projects = await getCollection('projects');
const all = [...resources, ...projects];
const checkedCount = all.filter((e) => e.data.provenance.checkedOn !== null).length;
---
<Base title="South African civic data, with provenance">
  <section class="hero">
    <h1>Find South African civic data, and know how far to trust it.</h1>
    <p>
      OpenForge is a read-only directory of civic data sources and tools. Every entry says where
      it came from, when it was last checked, and how confident we are.
    </p>
    <p>
      <a class="button" href="/resources/">Browse resources</a>
      <a class="button alt" href="/projects/">Browse projects</a>
    </p>
  </section>
  <section class="pillars">
    <div class="card">
      <h2>Resources</h2>
      <p>Gazettes, tenders, municipal finance and legal sources, each with a status.</p>
    </div>
    <div class="card">
      <h2>Projects</h2>
      <p>The civic tools built on top of that data, and who maintains them.</p>
    </div>
    <div class="card">
      <h2>Provenance</h2>
      <p>Moved, dead and unverified entries are shown as such, not hidden.</p>
    </div>
  </section>
  <section class="stats">
    <p class="meta">
      {resources.length} resources / {projects.length} projects /
      {checkedCount} of {all.length} entries checked
    </p>
  </section>
</Base>