---
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import ConfidenceMeter from '../../components/ConfidenceMeter.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

type Data = CollectionEntry<'projects'>['data'];
const projects = (await getCollection('projects')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);
const hay = (d: Data) => [d.title, d.summary, d.maintainer, d.tags.join(' ')].join(' ').toLowerCase();
const checked = (d: Date | null) => (d ? d.toISOString().slice(0, 10) : 'never');
const total = projects.length;
---
<Base title="Projects">
  <h1>Projects</h1>
  <p class="lede">Civic tools built on open data, with who maintains them and when we last checked.</p>
  <label for="q">Search projects</label>
  <input id="q" type="search" placeholder="Try census or budgets" />
  <div id="count" class="meta count" aria-live="polite">{total} {total === 1 ? 'project' : 'projects'}</div>
  <p id="empty" class="meta" hidden>No projects match that search.</p>
  <ul class="cards">
    {projects.map((p) => (
      <li class="card" data-search={hay(p.data)}>
        <div class="card-top">
          <span class="kicker">{p.data.tags.join(', ')}</span>
          <StatusBadge status={p.data.provenance.status} />
        </div>
        <h2><a href={`/projects/${p.id}/`}>{p.data.title}</a></h2>
        <p>{p.data.summary}</p>
        <div class="byline">Maintained by {p.data.maintainer}</div>
        <div class="prov">
          <div class="prov-row">
            <span class="conf">confidence <ConfidenceMeter level={p.data.provenance.confidence} /> {p.data.provenance.confidence}</span>
            <span>checked: {checked(p.data.provenance.checkedOn)}</span>
          </div>
          {p.data.provenance.notes && <p class="prov-note">Note: {p.data.provenance.notes}</p>}
        </div>
        <a class="card-link" href={`/projects/${p.id}/`}>
          View details
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false"><path d="M3 10H17M11 4L17 10L11 16" stroke="currentColor" stroke-width="2" fill="none" /></svg>
        </a>
      </li>
    ))}
  </ul>
</Base>
<script>
  const input = document.getElementById('q') as HTMLInputElement;
  const empty = document.getElementById('empty') as HTMLElement;
  const count = document.getElementById('count') as HTMLElement;
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-search]'));
  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    for (const li of items) {
      const hit = !q || (li.dataset.search ?? '').includes(q);
      li.hidden = !hit;
      if (hit) shown++;
    }
    count.textContent = `${shown} ${shown === 1 ? 'project' : 'projects'}`;
    empty.hidden = shown !== 0;
  });
</script>