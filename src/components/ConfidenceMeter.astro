---
interface Props { level: 'low' | 'medium' | 'high' }
const { level } = Astro.props;
---
<svg viewBox="0 0 30 8" width="30" height="8" aria-hidden="true" focusable="false">
  {level === 'high' && (
    <>
      <rect width="8" height="8" fill="currentColor" />
      <rect x="11" width="8" height="8" fill="currentColor" />
      <rect x="22" width="8" height="8" fill="currentColor" />
    </>
  )}
  {level === 'medium' && (
    <>
      <rect width="8" height="8" fill="currentColor" />
      <rect x="11" width="8" height="8" fill="currentColor" />
      <rect x="23" y="1" width="6" height="6" fill="none" stroke="currentColor" stroke-width="2" />
    </>
  )}
  {level === 'low' && (
    <>
      <rect width="8" height="8" fill="currentColor" />
      <rect x="12" y="1" width="6" height="6" fill="none" stroke="currentColor" stroke-width="2" />
      <rect x="23" y="1" width="6" height="6" fill="none" stroke="currentColor" stroke-width="2" />
    </>
  )}
</svg>